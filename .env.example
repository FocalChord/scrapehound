# One token+chat per bot (see config/bots.yaml). Copy to .env and fill in.
SHOES_BOT_TOKEN=
SHOES_CHAT_ID=
LEICA_BOT_TOKEN=
LEICA_CHAT_ID=

# Optional: residential proxy URL for Akamai/Cloudflare sites (New Balance, BHD)
NB_PROXY=

# Optional: Google Gemini key for comps `match:` semantic filtering (free tier,
# https://aistudio.google.com/apikey). Unset = matcher skipped (declarative
# filters still apply). Override the model with GEMINI_MODEL if desired.
GEMINI_API_KEY=
